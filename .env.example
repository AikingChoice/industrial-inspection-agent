LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=deepseek-chat
APP_ENV=development
# 生产部署时将 APP_ENV 设置为 production，并通过密钥管理系统注入。
API_AUTH_TOKEN=
MAX_UPLOAD_BYTES=10485760
ENABLE_LLM_DIAGNOSIS=false
ENABLE_VECTOR_SEARCH=false
LLM_TIMEOUT_SECONDS=15
LLM_APPROVED_HOSTS=
# 生产阈值需经现场设备工程师确认，并为每个配置版本指定 profile ID。
THRESHOLD_PROFILE_ID=demo-default
FAULT_KNOWLEDGE_VERSION=unversioned-dev
ALLOWED_DEVICE_IDS_JSON=
THRESHOLDS_JSON=
REQUIRED_SENSORS_JSON=
# 生产环境使用带 TLS 证书校验的 PostgreSQL。先应用 migrations/ 下的 SQL。
DATABASE_URL=
